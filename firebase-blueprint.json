{
  "entities": {
    "Character": {
      "title": "Character",
      "description": "A character in the story",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" }
      },
      "required": ["id", "name", "desc"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "A chapter in the story",
      "type": "object",
      "properties": {
        "chapter_num": { "type": "integer" },
        "text": { "type": "string" },
        "present_characters": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["chapter_num", "text", "present_characters"]
    },
    "Branch": {
      "title": "Branch",
      "description": "A story branch or hidden path",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "integer" },
        "condition_char": { "type": "string" },
        "condition_action": { "type": "string" },
        "condition_chapter": { "type": "integer" },
        "desc": { "type": "string" },
        "is_hidden": { "type": "boolean" },
        "hint": { "type": "string" },
        "side": { "type": "string", "enum": ["left", "right"] }
      },
      "required": ["id", "name", "score", "condition_char", "condition_action", "condition_chapter", "desc", "is_hidden", "side"]
    },
    "Ending": {
      "title": "Ending",
      "description": "A potential ending for the story",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"]
    },
    "Blueprint": {
      "title": "Blueprint",
      "description": "The complete story blueprint generated by AI",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "main_axis": { "type": "string" },
        "characters": {
          "type": "array",
          "items": { "$ref": "Character" }
        },
        "chapters": {
          "type": "array",
          "items": { "$ref": "Chapter" }
        },
        "endings": {
          "type": "array",
          "items": { "$ref": "Ending" }
        },
        "branches": {
          "type": "array",
          "items": { "$ref": "Branch" }
        },
        "left_mainline_default": { "type": "number" },
        "right_mainline_default": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["title", "main_axis", "characters", "chapters", "endings", "branches", "left_mainline_default", "right_mainline_default", "createdAt", "userId"]
    },
    "GameSession": {
      "title": "GameSession",
      "description": "The current state of a player's game",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "blueprintId": { "type": "string" },
        "gameState": { "type": "string" },
        "selectedThemes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "currentChapters": {
          "type": "array",
          "items": { "$ref": "Chapter" }
        },
        "interventionsLeft": { "type": "integer" },
        "endingValue": { "type": "number" },
        "unlockedBranches": {
          "type": "array",
          "items": { "$ref": "Branch" }
        },
        "intervenedChapters": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "characterStatuses": {
          "type": "object",
          "description": "Map of character ID to status object"
        },
        "storyConclusion": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "gameState", "updatedAt"]
    }
  },
  "firestore": {
    "/blueprints/{blueprintId}": {
      "schema": "Blueprint",
      "description": "Collection of all generated story blueprints"
    },
    "/sessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Collection of active game sessions"
    }
  }
}
