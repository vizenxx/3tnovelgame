{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/generate-blueprint",
      "destination": "/api/ai?action=generate-blueprint"
    },
    {
      "source": "/api/generate-next-chapter",
      "destination": "/api/ai?action=generate-next-chapter"
    },
    {
      "source": "/api/generate-summary",
      "destination": "/api/ai?action=generate-summary"
    },
    {
      "source": "/api/generate-cover",
      "destination": "/api/ai?action=generate-cover"
    },
    {
      "source": "/api/generate-series-world",
      "destination": "/api/ai?action=generate-series-world"
    },
    {
      "source": "/api/generate-continuity-node",
      "destination": "/api/ai?action=generate-continuity-node"
    },
    {
      "source": "/api/digest-chapter",
      "destination": "/api/ai?action=digest-chapter"
    },
    {
      "source": "/api/intervene",
      "destination": "/api/ai?action=intervene"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
