{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/generate-blueprint",
      "destination": "/api/ai?action=generate-blueprint"
    },
    {
      "source": "/api/generate-next-chapter",
      "destination": "/api/ai?action=generate-next-chapter"
    },
    {
      "source": "/api/generate-summary",
      "destination": "/api/ai?action=generate-summary"
    },
    {
      "source": "/api/generate-cover",
      "destination": "/api/ai?action=generate-cover"
    },
    {
      "source": "/api/generate-series-world",
      "destination": "/api/ai?action=generate-series-world"
    },
    {
      "source": "/api/generate-continuity-node",
      "destination": "/api/ai?action=generate-continuity-node"
    },
    {
      "source": "/api/digest-chapter",
      "destination": "/api/ai?action=digest-chapter"
    },
    {
      "source": "/api/intervene",
      "destination": "/api/ai?action=intervene"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
