# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Alternatively, some environments use API_KEY
API_KEY="MY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase client config for the browser app.
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_API_KEY="your-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your-firestore-database-id"
VITE_FIREBASE_MEASUREMENT_ID=""

# Firebase server-side auth verification for Vercel functions.
FIREBASE_PROJECT_ID="your-project-id"

# Optional: only set to "true" when you explicitly want the protected /api/debug-log endpoint enabled.
ENABLE_DEBUG_LOG="false"

# Supabase story backend migration.
SUPABASE_URL="https://dawnkpsqhhdelxfjbjve.supabase.co"
VITE_SUPABASE_URL="https://dawnkpsqhhdelxfjbjve.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Server-only. Never expose this in browser code or commit a real value.
SUPABASE_SECRET_KEY="sb_secret_xxx"
# Legacy fallback name if your Supabase dashboard only shows service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Firestore export/import migration scripts. Keep the service account JSON outside git.
FIREBASE_SERVICE_ACCOUNT_PATH="C:\\Users\\vizen\\Desktop\\firebase-service-account.json"
FIRESTORE_EXPORT_PATH="tmp\\firestore-export.json"
VITE_STORY_BACKEND="firebase"
